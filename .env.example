# InfraFlow local environment. Copy to .env (gitignored).
NODE_ENV=development

# Postgres (docker compose service "db" -> host port 5455)
DATABASE_URL=postgresql://infraflow:infraflow@localhost:5455/infraflow
TEST_DATABASE_URL=postgresql://infraflow:infraflow@localhost:5455/infraflow_test
POSTGRES_PASSWORD=infraflow

# API
API_PORT=4000
JWT_SECRET=dev-only-change-me-please-32chars-min
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:8088
UPLOAD_DIR=./apps/api/uploads

# Demo accounts share this password (seed only; never for production)
DEMO_PASSWORD=Demo@12345

# AI copilot: leave OPENAI_API_KEY empty to use the deterministic offline provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
